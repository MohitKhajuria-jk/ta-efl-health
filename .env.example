# These settings must be set in the server process environment; no dotenv loader is installed.
# TA_EFL_SETTINGS=C:/path/to/a/local/settings.json
# TA_EFL_ALLOWED_HOSTS=localhost,127.0.0.1
# TA_EFL_PORT=8780
# TA_EFL_API_TARGET=http://127.0.0.1:8780
# Enable only when serving behind HTTPS:
# TA_EFL_SECURE_COOKIES=1
FLWR_TELEMETRY_ENABLED=0
MPLBACKEND=Agg
