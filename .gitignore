# --- Python ---------------------------------------------------------------
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Local research state and configuration --------------------------------
# Experiment records, models, accounts and web jobs stay on the local machine.
storage/
!storage/.gitkeep
config/settings*.json
.env
.env.*
!.env.example

# --- Datasets ----------------------------------------------------------------
# Download with scripts/fetch_datasets.py (see data/README.md); never commit
# patient-level files.
data/*.csv
data/*.zip
data/*.xlsx
data/*.parquet

# --- Web -------------------------------------------------------------------------
web/node_modules/
web/dist/
web/test-results/
*.tsbuildinfo

# --- Test and debug output -------------------------------------------------
test-results/
debug.log

# --- Office / OS -------------------------------------------------------------
~$*.docx
~$*.xlsx
~$*.pptx
*.lnk
.DS_Store
Thumbs.db
desktop.ini
